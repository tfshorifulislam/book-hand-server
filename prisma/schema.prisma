generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String        @id @default(ulid())
  name          String
  email         String        @unique
  emailVerified Boolean
  image         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  account       Account[]
  sessions      Session[]
  bookListings  BookListing[]
  savedBooks    SavedBook[]

  @@map("user")
}

model Account {
  id         String @id @default(uuid())
  accountId  String
  providerId String
  userId     String

  issuer                String?
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Session {
  id        String   @id @default(ulid())
  expiresAt DateTime
  token     String   @unique
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
  userAgent String?
  ipAddress String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("session")
}

model Verification {
  id         String   @id @default(ulid())
  identifier String   @unique
  value      String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([expiresAt])
  @@map("verification")
}

model Book {
  id          String   @id @default(uuid())
  title       String
  author      String
  description String
  coverImage  String
  category    String
  language    String
  publishedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  listings BookListing[]

  @@index([title])
  @@index([author])
  @@index([category])
  @@index([language])
}

model BookListing {
  id          String   @id @default(uuid())
  bookId      String
  sellerId    String
  price       Float
  condition   String
  description String?
  status      String   @default("AVAILABLE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  book       Book        @relation(fields: [bookId], references: [id])
  seller     User        @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  savedBooks SavedBook[]

  @@index([bookId])
  @@index([sellerId])
  @@index([status])
  @@index([status, createdAt])
}

model SavedBook {
  id        String   @id @default(cuid())
  userId    String
  listingId String
  createdAt DateTime @default(now())

  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing BookListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([userId, listingId])
  @@index([userId])
  @@index([listingId])
}
